# Railway에서 PostgreSQL을 추가하면 자동으로 주입됩니다.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 관리자 계정 생성 시에만 사용합니다 (npm run create-admin).
# 계정을 만든 뒤에는 Railway 변수에서 지워도 됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 검색엔진 소유 확인 (선택) — 넣으면 <head>에 인증 메타 태그가 붙습니다.
# 네이버: 서치어드바이저 → 사이트 등록 → HTML 태그의 content 값
# 구글:  서치콘솔 → 소유권 확인 → HTML 태그의 content 값
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
