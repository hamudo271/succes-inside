# Railway에 PostgreSQL을 추가하는 것만으로는 웹 서비스에 값이 들어오지 않습니다.
# 웹 서비스의 Variables에서 변수 참조로 직접 걸어야 합니다: ${{Postgres.DATABASE_URL}}
# 비어 있으면 관리자와 신청·구독 접수가 꺼지고, 공개 사이트만 예시 글로 동작합니다.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 첫 관리자 계정. 배포할 때 계정이 하나도 없으면 이 값으로 자동 생성됩니다.
# 이미 계정이 있으면 무시하므로, 배포한다고 비밀번호가 되돌아가지 않습니다.
# 로그인한 뒤에는 이 두 변수를 지우고, 비밀번호는 /admin/account 에서 바꾸세요.
# 규칙: 아이디 영문·숫자·._- 3~32자 / 비밀번호 12자 이상, 소문자·대문자·숫자·기호 중 3종류 이상
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 검색엔진 소유 확인 (선택) — 넣으면 <head>에 인증 메타 태그가 붙습니다.
# 네이버: 서치어드바이저 → 사이트 등록 → HTML 태그의 content 값
# 구글:  서치콘솔 → 소유권 확인 → HTML 태그의 content 값
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# 신청 알림 메일 (선택) — 사이트 신청이 들어오면 아래 주소로 보냅니다. 비우면 안 보냅니다.
# resend.com 가입 → API Keys 에서 발급. 도메인 인증 전에는 가입한 메일 주소로만 보낼 수 있습니다.
RESEND_API_KEY=
NOTIFY_TO=success.inside.kr@gmail.com
# 도메인(successinside.kr)을 Resend에 인증한 뒤 바꿉니다. 전에는 기본값(onboarding@resend.dev)을 씁니다.
NOTIFY_FROM=
